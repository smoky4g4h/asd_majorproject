# Copy to .env.local. Never commit credentials. Use a development project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported in place of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gmail API invitation sender (server-only; separate from Google sign-in).
# Authorize the sending mailbox with gmail.send and offline access.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional integration tests; separate disposable development accounts only.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SECRET_KEY=
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=
TEST_FOREIGN_EMAIL=
TEST_FOREIGN_PASSWORD=

# Google Cloud OAuth Web application credentials (server-only setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only random secret for the trusted media recovery scheduler.
MEDIA_WORKER_SECRET=

# Enable only after worker:meetings is deployed and its delivery probe passes.
CHAT_SCHEDULING_ENABLED=false
